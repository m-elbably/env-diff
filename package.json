{
  "name": "env-diff",
  "version": "1.0.0",
  "description": "A TUI tool to visually diff .env, .yaml and .json files",
  "type": "module",
  "bin": {
    "env-diff": "./src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --watch run src/index.tsx",
    "test": "bun test",
    "build": "bash scripts/build.sh",
    "build:dev": "bun build src/index.tsx --outdir=dist --target=bun"
  },
  "dependencies": {
    "@opentui/core": "latest",
    "@opentui/react": "latest",
    "js-yaml": "^4.1.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/react": ">=19.0.0",
    "typescript": "latest"
  },
  "engines": {
    "bun": ">=0.4.0"
  },
  "author": "Mohamed El-Bably",
  "license": "MIT"
}